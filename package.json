{
  "name": "yt-dlp-app",
  "private": true,
  "packageManager": "pnpm@10.16.0",
  "scripts": {
    "dev": "pnpm --filter apps dev",
    "dev:renderer": "pnpm --filter renderer dev",
    "dev:electron": "pnpm --filter electron-shell dev",
    "build": "pnpm --filter apps build",
    "lint": "pnpm lint:js && pnpm lint:py",
    "lint:js": "biome check .",
    "lint:py": "app/downloader/.venv/bin/ruff check app/downloader",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "husky": "^9.1.7"
  }
}
