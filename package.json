{
  "name": "dlynx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.0",
  "scripts": {
    "dev": "concurrently -k \"pnpm --filter ./app/renderer dev\" \"wait-on http://127.0.0.1:5173 && pnpm dev:electron\"",
    "dev:electron": "VITE_DEV_SERVER_URL=http://127.0.0.1:5173 pnpm --filter ./app/electron dev",
    "clean": "rm -rf dist && make -C app/downloader clean",
    "clean:tools": "rm -rf app/downloader/bin",
    "build": "pnpm --filter ./app/renderer build && make -C app/downloader build && pnpm --filter ./app/electron build",
    "install:ffmpeg": "node scripts/install-ffmpeg.mjs",
    "db:clear": "node scripts/clear-history.mjs",
    "start": "pnpm build && pnpm --filter ./app/electron start",
    "test": "vitest",
    "format": "biome check --write . && make -C app/downloader format",
    "lint": "biome check . && pnpm lint:downloader",
    "lint:downloader": "make -C app/downloader check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@types/node": "^22.19.15",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.4"
  }
}
