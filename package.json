{
  "name": "dlynx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.0",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:renderer\" \"pnpm dev:electron:wait\"",
    "dev:renderer": "pnpm --filter ./app/renderer dev",
    "dev:electron:wait": "wait-on http://127.0.0.1:5173 && pnpm dev:electron",
    "dev:electron": "VITE_DEV_SERVER_URL=http://127.0.0.1:5173 pnpm --filter ./app/electron dev",
    "clean": "rm -rf dist",
    "clean:tools": "rm -rf app/downloader/bin",
    "clean:all": "pnpm clean && pnpm clean:tools",
    "build": "pnpm build:renderer && pnpm build:runtime-tools && pnpm build:electron",
    "build:renderer": "pnpm --filter ./app/renderer build",
    "build:runtime-tools": "tsc --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --isolatedModules --types node --outDir dist/runtime-tools app/runtime-tools/install.mts",
    "build:electron": "pnpm --filter ./app/electron build",
    "install:tools": "pnpm build:runtime-tools && node dist/runtime-tools/install.mjs",
    "db:clear": "node scripts/clear-history.mjs",
    "start": "pnpm build && pnpm --filter ./app/electron start",
    "preview": "pnpm --filter ./app/renderer preview",
    "test": "vitest",
    "lint": "biome check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@types/node": "^22.19.15",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "wait-on": "^9.0.4"
  }
}
