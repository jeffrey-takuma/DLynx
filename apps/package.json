{
  "name": "apps",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron:wait\"",
    "dev:renderer": "npm run dev --prefix renderer",
    "dev:electron:wait": "wait-on http://127.0.0.1:5173 && npm run dev:electron",
    "dev:electron": "VITE_DEV_SERVER_URL=http://localhost:5173 npm run dev --prefix electron",
    "build": "npm run build --prefix renderer",
    "start": "npm run start --prefix electron",
    "preview": "npm run preview --prefix renderer",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "wait-on": "^9.0.4"
  }
}
